# Copy this file to .env.local and fill in real values.
# Both are optional - the site works fine without them (analytics scripts just won't load).
# Set these in Vercel under Project Settings -> Environment Variables for production.

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity project ID (from clarity.microsoft.com)
NEXT_PUBLIC_CLARITY_ID=
