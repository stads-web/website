# Copy this file to .env.local and fill in real values.
# Everything here is optional for local work. In production, set these in Vercel
# under Project Settings -> Environment Variables. Never commit real values.

# --- Site address -------------------------------------------------------------
# Defaults to https://www.stads.de (src/lib/site.ts), so normally not needed.
# NEXT_PUBLIC_SITE_URL=
# Base URL used for links inside the confirmation mail (logo, privacy page).
# SITE_URL=

# --- Analytics (only loaded after "Accept all" in the cookie banner) ---------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity project ID (from clarity.microsoft.com)
NEXT_PUBLIC_CLARITY_ID=

# --- Contact form (src/app/api/contact/route.ts) ------------------------------
# Resend API key. Without it (and without TEAMS_WEBHOOK_URL) the form reports an
# error and offers the message as a prepared mail instead.
RESEND_API_KEY=
# Sender, must be on a domain verified in Resend, e.g. "STADS Website <formular@stads.de>".
CONTACT_FROM=
# Recipient(s), comma separated. Default: address in content/for-companies/contact.md.
CONTACT_TO=

# Optional: also post each inquiry into a Teams channel (Workflows webhook).
TEAMS_WEBHOOK_URL=
TEAMS_MENTION_EMAIL=
TEAMS_MENTION_NAME=
